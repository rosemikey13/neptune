                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "editorMode": "code",
                        "expr": "(node_memory_MemTotal_bytes{job=\"artifactory\"} - node_memory_MemAvailable_bytes{job=\"artifactory\"}) / node_memory_MemTotal_bytes{job=\"artifactory\"} * 100",
